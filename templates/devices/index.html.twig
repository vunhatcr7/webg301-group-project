{% extends 'base.html.twig' %}

{% block title %}Devices index{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Devices List</h1>
            <p class="text-muted small mb-0">Quản lý thiết bị và thông tin liên quan.</p>
        </div>
        <a href="{{ path('app_devices_new') }}" class="btn btn-success btn-sm shadow-sm">
            <i class="fas fa-plus"></i> Create new
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Name</th>
                            <th scope="col">Model</th>
                            <th scope="col">Manufacturer</th>
                            <th scope="col">Category</th>
                            <th scope="col">Price</th>
                            <th scope="col">Rating</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for device in devices %}
                        <tr>
                            <td>{{ device.id }}</td>
                            <td>{{ device.Name }}</td>
                            <td>{{ device.Model }}</td>
                            <td>{{ device.Manufacturer }}</td>
                            <td>{{ device.Category.name }}</td>
                            <td>{{ device.Price }}</td>
                            <td>
                                <span class="badge bg-info text-dark">{{ device.AverageRating }}</span>
                            </td>
                            <td>
                                <a href="{{ path('app_devices_show', {'id': device.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_devices_edit', {'id': device.id}) }}" class="btn btn-sm btn-warning text-white">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">No records found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
