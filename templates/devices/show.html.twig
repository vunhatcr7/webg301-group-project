{% extends 'base.html.twig' %}

{% block title %}{{ device.name }} - Devices{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_devices_index') }}">Devices</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ device.name }}</li>
        </ol>
    </nav>

    <!-- Product Details Card -->
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <!-- Product Image Section -->
                <div class="col-md-5 col-lg-4 mb-4 mb-md-0">
                    <div class="product-image-frame border rounded p-3 bg-light text-center" style="min-height: 300px; display: flex; align-items: center; justify-content: center;">
                        <img src="{{ asset('img/no-image-placeholder.png') }}" alt="{{ device.name }}" class="img-fluid" style="max-height: 280px; max-width: 100%;">
                    </div>
                </div>

                <!-- Product Information Section -->
                <div class="col-md-7 col-lg-8">
                    <!-- Product Name -->
                    <h1 class="mb-3">{{ device.name }}</h1>

                    <!-- Product Details -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <h6 class="text-uppercase text-muted small">Model</h6>
                            <p class="fs-6">{{ device.model ?? 'N/A' }}</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6 class="text-uppercase text-muted small">Manufacturer</h6>
                            <p class="fs-6">{{ device.manufacturer ?? 'N/A' }}</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6 class="text-uppercase text-muted small">Category</h6>
                            <p class="fs-6">
                                <span class="badge bg-info">{{ device.category.name }}</span>
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6 class="text-uppercase text-muted small">Rating</h6>
                            <p class="fs-6">
                                {% if device.averageRating %}
                                    <span class="text-warning">
                                        {% for i in range(1, device.averageRating|round|int + 1) %}
                                            ★
                                        {% endfor %}
                                        {% if device.averageRating % 1 >= 0.5 %}
                                            ☆
                                        {% endif %}
                                    </span>
                                    <span class="ms-2">({{ device.averageRating|round(1) }}/5)</span>
                                {% else %}
                                    <span class="text-muted">No ratings yet</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <!-- Price Section -->
                    <div class="price-section border-top border-bottom py-3 my-3">
                        <h6 class="text-uppercase text-muted small mb-2">Price</h6>
                        <h3 class="text-success fw-bold">
                            {{ device.price|format_currency('VND', '', {
                                'fraction_digit': 0,
                                'grouping': true
                            }) }}
                        </h3>
                    </div>

                    <!-- Device ID -->
                    <div class="text-muted small mt-3">
                        <p>Product ID: <strong>#{{ device.id }}</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 d-flex gap-2">
        <a href="{{ path('app_devices_edit', {'id': device.id}) }}" class="btn btn-primary">
            <i class="fas fa-edit"></i> Edit
        </a>
        
        <a href="{{ path('app_devices_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <!-- Delete Section -->
    <div class="mt-3">
        {{ include('devices/_delete_form.html.twig') }}
    </div>
</div>

<style>
    .product-image-frame {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        transition: transform 0.2s ease-in-out;
    }

    .product-image-frame:hover {
        transform: scale(1.02);
    }

    .price-section {
        background-color: #f8f9fa;
    }
</style>
{% endblock %}
