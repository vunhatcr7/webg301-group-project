{% extends 'base.html.twig' %}

{% block title %}Customers
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<a href="{{ path('app_customers_index') }}">back to list</a>

		<h1>Customers</h1>

		<table class="table">
			<tbody>
				<tr>
					<th>Id</th>
					<td>{{ customer.id }}</td>
				</tr>
				<tr>
					<th>Phone Number</th>
					<td>{{ customer.PhoneNumber }}</td>
				</tr>
				<tr>
					<th>Full Name</th>
					<td>{{ customer.FullName }}</td>
				</tr>
				<tr>
					<th>Name</th>
					<td>{{ customer.Name }}</td>
				</tr>
				<tr>
					<th>Age</th>
					<td>{{ customer.Age }}</td>
				</tr>
				<tr>
					<th>Date Of Birth</th>
					<td>{{ customer.DateOfBirth ? customer.DateOfBirth|date('Y-m-d H:i:s') : '' }}</td>
				</tr>
				<tr>
					<th>Gender</th>
					<td>{{ customer.Gender ? 'Nam' : 'Nữ' }}</td>
				</tr>
				<tr>
					<th>Email</th>
					<td>{{ customer.Email }}</td>
				</tr>
				<tr>
					<th>Address</th>
					<td>{{ customer.Address }}</td>
				</tr>
			</tbody>
		</table>


		<a href="{{ path('app_customers_edit', {'id': customer.id}) }}">Edit</a>

		{{ include('customers/_delete_form.html.twig') }}
	</div>
{% endblock %}
