{% extends 'base.html.twig' %}

{% block title %}Order{% endblock %}

{% block body %}
<div class="container-fluid">
    <a href="{{ path('app_order_index') }}">back to list</a>

    <h1>Order</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ order.id }}</td>
            </tr>
            <tr>
                <th>Customer</th>
                <td>{{ order.Customer.Name }}</td>
            </tr>
            {# <tr>
                <th>DateCreated</th>
                <td>{{ order.DateCreated ? order.DateCreated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>PhoneNumber</th>
                <td>{{ order.PhoneNumber }}</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>{{ order.Address }}</td>
            </tr> #}
            <tr>
                <th>Total</th>
                <td>{{ order.totalAmount }}</td>
            </tr>
            <tr>
                <th>Note</th>
                <td>{{ order.Note }}</td>
            </tr>
        </tbody>
    </table>


    <a href="{{ path('app_order_edit', {'id': order.id}) }}">edit</a>

    {{ include('order/_delete_form.html.twig') }}
