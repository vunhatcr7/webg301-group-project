{% extends 'base.html.twig' %}

{% block title %}Comment{% endblock %}

{% block body %}
    <h1>Comment</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ comment.id }}</td>
            </tr>
            <tr>
                <th>DeviceId</th>
                <td>{{ comment.DeviceId }}</td>
            </tr>
            <tr>
                <th>Position</th>
