{{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
    {% for field in form %}
        <div class="col-md-6"> <!-- Điều chỉnh kích thước cột tùy theo nhu cầu -->
            <div class="form-group">
                {{ form_label(field, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(field, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(field) }}
            </div>
        </div>
    {% endfor %}
    <div class="col-md-12">
        <button class="btn btn-primary w-100">{{ button_label|default('Save') }}</button>
    </div>
{{ form_end(form) }}