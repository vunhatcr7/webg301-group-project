{% extends 'base.html.twig' %}

{% block title %}Rating{% endblock %}

{% block body %}
    <h1>Rating</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ rating.id }}</td>
            </tr>
            <tr>
                <th>DeviceId</th>
                <td>{{ rating.DeviceId }}</td>
            </tr>
            <tr>
                <th>Points</th>
                <td>{{ rating.Points }}</td>
            </tr>
            <tr>
                <th>DateCreated</th>
                <td>{{ rating.DateCreated ? rating.DateCreated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_rating_index') }}">back to list</a>

    <a href="{{ path('app_rating_edit', {'id': rating.id}) }}">edit</a>

    {{ include('rating/_delete_form.html.twig') }}
{% endblock %}
