{# filepath: templates/devices/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Devices List{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        {% for device in devices %}
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">{{ device.name }}</h5>
                        <p class="card-text">
                            <strong>Category:</strong> {{ device.category.name }}<br>
                            <strong>Model:</strong> {{ device.model }}<br>
                            <strong>Manufacturer:</strong> {{ device.manufacturer }}<br>
                            <strong>Price:</strong> ${{ device.price }}<br>
                            <strong>Rating:</strong> {{ device.averageRating }} stars
                        </p>
                        <a href="{{ path('user_device_show', { id: device.id }) }}" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>No devices found.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}